# Copia este archivo a .env y pega tu API key de https://console.groq.com/
GROQ_API_KEY=

# AWS Price List API (obligatorio para calcular costos; sin credenciales las tools fallan)
# https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/price-changes.html
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Región del endpoint del cliente pricing (us-east-1, eu-central-1 o ap-south-1)
# PRICING_API_REGION=us-east-1

# TTL de caché en segundos (por defecto 24 h)
# PRICING_CACHE_TTL_SECONDS=86400
